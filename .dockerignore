# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
*.tsbuildinfo
next-env.d.ts

# Version control and CI
.git
.gitignore
.github

# Env files: secrets must never end up in an image layer
.env*
!.env.example

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs, editor and OS files
*.log
npm-debug.log*
.vscode
.idea
.DS_Store

# Docs not needed at runtime
README.md
AGENTS.md
CHANGELOG.md