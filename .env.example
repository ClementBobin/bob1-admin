# Copy this file to .env.local (or .env) and adjust the values.
#
# NEXT_PUBLIC_USE_MOCK:
#   true  -> the admin UI runs entirely on the fixtures in lib/data.ts
#   false -> the admin UI logs in against Bob1-api and reads/writes real data
NEXT_PUBLIC_USE_MOCK=true

# Base URL of Bob1-api. Do not include /api/v1: lib/api.ts appends it.
NEXT_PUBLIC_API_URL=http://localhost:5000
